# =============================================================================
# edge-model-runtime — .env.example
# Copy to .env:  cp .env.example .env
# Then edit AI_DATA_ROOT and GPU_DRIVER for your machine.
# =============================================================================

# ── GPU driver ──────────────────────────────────────────────────────────────
# Controls which docker-compose overlay is loaded by the compose() wrapper:
#   cpu    → CPU-only inference — works everywhere, no GPU toolkit needed
#   nvidia → NVIDIA GPU via Container Toolkit (needs nvidia-container-toolkit)
#   intel  → Intel Arc GPU via /dev/dri (needs Intel compute-runtime in WSL2)
#
# HP EliteBook with Intel Arc 140T on WSL2: GPU_DRIVER=intel
# MSI EdgeXpert / DGX Spark (NVIDIA):       GPU_DRIVER=nvidia
# Any machine, safest default:              GPU_DRIVER=cpu
GPU_DRIVER=cpu

# ── Data root ───────────────────────────────────────────────────────────────
# All model data, configs, and logs live here — never inside containers.
# Needs ≥ 100 GB free. The ollama/ subdir must NEVER be deleted unless you
# intentionally want to wipe all downloaded models.
#
# Linux / WSL2 examples:
#   AI_DATA_ROOT=/home/${USER}/ai-data
#   AI_DATA_ROOT=/mnt/d/ai-data          (D: drive from WSL2)
# NVIDIA DGX Spark:
#   AI_DATA_ROOT=/home/expert/ai-data
AI_DATA_ROOT=/home/${USER}/ai-data

# ── Ports ───────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
WEBUI_PORT=3000
LITELLM_PORT=4000
VLLM_PORT=8000
OPENHANDS_PORT=3030
TENSORBOARD_PORT=6006
JUPYTER_PORT=8888

# ── Ollama tuning ───────────────────────────────────────────────────────────
# KEEP_ALIVE: how long to keep a loaded model in VRAM between requests.
# NUM_PARALLEL / MAX_LOADED_MODELS: keep at 1 unless you have abundant VRAM.
# FLASH_ATTENTION: 1 = enabled (recommended for compatible GPUs/CPUs).
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1

# ── Open WebUI ──────────────────────────────────────────────────────────────
# WEBUI_SECRET_KEY is auto-generated by 00-install.sh — leave blank here.
WEBUI_SECRET_KEY=
WEBUI_ENABLE_SIGNUP=true
WEBUI_DEFAULT_USER_ROLE=pending
ENABLE_OPENAI_API=true

# ── LiteLLM proxy (optional: profile=cloud) ─────────────────────────────────
# LITELLM_MASTER_KEY: clients present this as the OpenAI API key. Change it.
LITELLM_MASTER_KEY=sk-changeme
LITELLM_LOG=INFO

# ── Cloud API keys (leave blank to disable a provider) ──────────────────────
ANTHROPIC_API_KEY=
OPENAI_PROVIDER_API_KEY=
GEMINI_API_KEY=

# ── LM Studio bridge (optional, GPU_DRIVER=intel or any) ────────────────────
# Used when scripts/37-setup-lmstudio.sh wires a host LM Studio into LiteLLM.
LMSTUDIO_HOST=host.docker.internal
LMSTUDIO_PORT=1234
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_API_KEY=lm-studio

# ── vLLM (optional: profile=vllm, NVIDIA GPU required) ─────────────────────
HF_TOKEN=
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEM_UTIL=0.90

# ── Training (optional: profile=training, NVIDIA GPU required) ──────────────
WANDB_API_KEY=

# ── NVIDIA GPU tuning (used only when GPU_DRIVER=nvidia) ────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ── OpenHands (optional: profile=coding-web) ────────────────────────────────
# OPENHANDS_HOST_IP: LAN IP of this machine. Required so sandbox containers
# (which run on the default bridge network, not edge-ai-net) can reach
# LiteLLM and OpenHands. Set to the output of `hostname -I | awk '{print $1}'`.
OPENHANDS_HOST_IP=
# OPENHANDS_HOST_URL: URL the browser uses to reach OpenHands (for CORS).
OPENHANDS_HOST_URL=http://localhost:3030
# OPENHANDS_LLM_BASE_URL: LiteLLM endpoint for OpenHands + its sandbox.
# Use http://<OPENHANDS_HOST_IP>:4000 (NOT http://litellm:4000 — sandbox
# containers cannot resolve container hostnames on the default bridge).
OPENHANDS_LLM_BASE_URL=http://localhost:4000
OPENHANDS_LLM_MODEL=qwen3-coder-32k
GITHUB_TOKEN=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
