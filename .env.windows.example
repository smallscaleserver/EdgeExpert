# =============================================================================
# edge-model-runtime — .env.windows.example  (Windows-native Ollama mode)
# =============================================================================
# Copy to .env.windows:
#   copy .env.windows.example .env.windows    (Command Prompt)
#   Copy-Item .env.windows.example .env.windows  (PowerShell)
#
# Then run:
#   docker compose -f docker-compose.windows.yml --env-file .env.windows --env-file .env.versions up -d
#   (or: make win-up)
#
# NOTE: Ollama runs as ollama.exe on Windows — NOT in Docker.
#   Install from https://ollama.com/download/windows
#   Set OLLAMA_HOST=0.0.0.0 before starting Ollama so Docker can reach it
#   (see docs/WINDOWS-SETUP.md for full instructions).
# =============================================================================

# ── Data root ───────────────────────────────────────────────────────────────
# Where Open WebUI stores its database and settings.
# Docker Desktop for Windows accepts forward-slash Windows paths.
# Make sure this directory exists and Docker Desktop has access to the drive
# (Settings → Resources → File Sharing).
AI_DATA_ROOT=C:/ai-data

# ── Ports ───────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
WEBUI_PORT=3000
LITELLM_PORT=4000

# ── Open WebUI ──────────────────────────────────────────────────────────────
# WEBUI_SECRET_KEY: set any random string (or generate with: openssl rand -hex 32)
WEBUI_SECRET_KEY=change-me-to-a-random-secret
WEBUI_ENABLE_SIGNUP=true
WEBUI_DEFAULT_USER_ROLE=pending
ENABLE_OPENAI_API=true

# ── LiteLLM proxy (optional: make win-cloud) ────────────────────────────────
LITELLM_MASTER_KEY=sk-changeme
LITELLM_LOG=INFO

# ── Cloud API keys (leave blank to disable) ──────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_PROVIDER_API_KEY=
GEMINI_API_KEY=

# ── LM Studio bridge (optional) ──────────────────────────────────────────────
# LM Studio runs on the Windows host at port 1234 by default.
LMSTUDIO_PORT=1234
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_API_KEY=lm-studio
