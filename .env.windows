# =============================================================================
# edge-model-runtime — .env.windows  (Windows-native Ollama mode)
# Generated for first-run. WEBUI_SECRET_KEY randomized — do not commit to git.
# =============================================================================

# ── Data root ───────────────────────────────────────────────────────────────
AI_DATA_ROOT=C:/ai-data

# ── Ports ───────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
WEBUI_PORT=3000
LITELLM_PORT=4000

# ── Open WebUI ──────────────────────────────────────────────────────────────
WEBUI_SECRET_KEY=8a5cef1ba371a4a630077f583dc3c428c2676c501c839f4d5cb3569569b250e2
WEBUI_ENABLE_SIGNUP=true
WEBUI_DEFAULT_USER_ROLE=pending
ENABLE_OPENAI_API=true

# ── LiteLLM proxy (optional: make win-cloud) ────────────────────────────────
LITELLM_CONFIG_FILE=config.windows.yaml
LITELLM_MASTER_KEY=sk-changeme
LITELLM_LOG=INFO

# ── Cloud API keys (leave blank to disable) ──────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_PROVIDER_API_KEY=
GEMINI_API_KEY=

# ── LM Studio bridge (optional) ──────────────────────────────────────────────
LMSTUDIO_PORT=1234
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_API_KEY=lm-studio
