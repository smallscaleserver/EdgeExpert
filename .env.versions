# =============================================================================
# edge-model-runtime — .env.versions
# Pinned image tags. Never use 'latest' or 'main' (CI enforces this).
# To update: edit tags here, then run: bash scripts/09-update-images.sh
# Verify current tags at:
#   https://hub.docker.com/r/ollama/ollama/tags
#   https://github.com/open-webui/open-webui/releases
#   https://github.com/BerriAI/litellm/releases
#   https://github.com/vllm-project/vllm/releases
#   https://github.com/All-Hands-AI/OpenHands/releases
# =============================================================================

# Core services
OLLAMA_IMAGE=ollama/ollama:0.20.7
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.9.5

# Optional: LiteLLM cloud proxy (profile=cloud)
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest

# Optional: vLLM (profile=vllm, NVIDIA only)
VLLM_IMAGE=vllm/vllm-openai:v0.20.0

# Optional: OpenHands web IDE (profile=coding-web)
OPENHANDS_IMAGE=ghcr.io/openhands/openhands:1.6.0
OPENHANDS_AGENT_IMAGE_TAG=1.6.0

# Optional: PyTorch training shell (profile=training, NVIDIA only)
TRAINING_IMAGE=nvcr.io/nvidia/pytorch:26.04-py3

# NVIDIA GPU test image (used by 00-install.sh when GPU_DRIVER=nvidia)
CUDA_TEST_IMAGE=nvidia/cuda:12.4.1-base-ubuntu22.04

# Intel Arc GPU image (used when GPU_DRIVER=intel)
# ipex-llm provides Ollama-compatible API with Intel oneAPI acceleration.
# Verify latest tag at: https://hub.docker.com/r/intelanalytics/ipex-llm-inference-cpp-xpu/tags
OLLAMA_INTEL_IMAGE=intelanalytics/ipex-llm-inference-cpp-xpu:2.2.0b20250112-xpu
